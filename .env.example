# Configuration only: Python reads this file. Never run or source it.
# Copy Azure values from the environment owner. No passwords, keys, or tokens.
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_EXPECTED_USERNAME=<signed-in-user-upn>
AZURE_RESOURCE_GROUP=<existing-resource-group>
AZURE_AI_ACCOUNT_NAME=<existing-foundry-account>
AZURE_AI_PROJECT_NAME=<existing-project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_SEARCH_NAME=<existing-search-service>
AZURE_SEARCH_ENDPOINT=https://<search>.search.windows.net
AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com
AZURE_APPLICATION_INSIGHTS_NAME=<connected-app-insights-name>

# Unused team names. Keep these and LAB_LANGUAGE unchanged after starting a run.
LAB_PREFIX=ll-team01
LAB_AGENT_NAME=frontier-loop-team01

# Actual Azure deployment names, not model IDs. Examples do not create models.
# Keep the owner's shared names even when you choose a new team prefix.
MODEL_SOL_DEPLOYMENT=ll-team01-sol
MODEL_LUNA_DEPLOYMENT=ll-team01-luna
MODEL_ASTRA_DEPLOYMENT=ll-team01-astra
LAB_AUX_DEPLOYMENT=gpt-5.4-mini

# Fixed model ID and experiment settings. English uses LAB_LANGUAGE=en.
# Change V1 to V2 only through the guide's set-prompt step.
LAB_AUX_MODEL=gpt-5.4-mini
LAB_PROMPT_VERSION=v1
LAB_LANGUAGE=ko
LAB_AUTH_MODE=cli
LAB_AS_OF_DATE=2026-09-10
LAB_MAX_OUTPUT_TOKENS=2048
